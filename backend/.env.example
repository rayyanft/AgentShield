# ─────────────────────────────────────────────────────────────────────────────
# AgentShield backend – environment variable template
# Copy to .env and fill in values if you want optional features.
# The demo works with NO values set.
# ─────────────────────────────────────────────────────────────────────────────

# Optional: future LLM provider (not required for the demo)
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# SQLite database file path (relative to backend/)
# DATABASE_URL=sqlite:///./agentshield.db

# CORS allowed origin for the local frontend dev server
# CORS_ORIGIN=http://localhost:5173
